# 데이터베이스
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=
# 빈 DB로 처음 시작할 때만 true. 운영(NODE_ENV=production)에서는 설정과 상관없이 꺼진다.
DATABASE_SYNCHRONIZE=
NODE_ENV=

# 인증 (시크릿은 32바이트 이상)
AUTH_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=
AUTH_TOKEN_ISSUER=randevu-api
AUTH_TOKEN_AUDIENCE=randevu-client
AUTH_ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
AUTH_REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000

# 소셜 로그인 토큰 발급 대상 검증 (없으면 검증을 건너뛰고 시작 시 경고)
GOOGLE_CLIENT_ID=
KAKAO_APP_ID=

# 관리 API (이동시간 캐시 재생성). 32자 이상, 없으면 관리 API가 닫힌다.
ADMIN_API_KEY=

# 외부 API
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 추가로 허용할 프론트 출처(쉼표 구분)
CORS_ORIGINS=
